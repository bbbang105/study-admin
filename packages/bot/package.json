{
  "name": "@blog-study/bot",
  "version": "1.0.0",
  "private": true,
  "description": "큐스팅 4th 디스코드 봇",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsup",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "rss-collect": "tsx src/scripts/rss-collect.ts",
    "test-attendance": "tsx src/scripts/test-attendance-check.ts",
    "test-fine-reminder": "tsx src/scripts/test-fine-reminder.ts",
    "test-round-report": "tsx src/scripts/test-round-report.ts",
    "test-curation": "tsx src/scripts/test-curation-crawl.ts",
    "test-weekly-ranking": "tsx src/scripts/test-weekly-ranking.ts",
    "test-discord-message": "tsx src/scripts/test-discord-message.ts",
    "test-rss-poll": "tsx src/scripts/test-rss-poll.ts",
    "seed-test-data": "tsx src/scripts/seed-test-data.ts",
    "check-keywords": "tsx src/scripts/check-keywords.ts",
    "seed-keywords": "tsx src/scripts/seed-keywords.ts",
    "recalculate-relevance": "tsx src/scripts/recalculate-relevance.ts",
    "backfill-curation-embeddings": "tsx src/scripts/backfill-curation-embeddings.ts",
    "backfill-post-embeddings": "tsx src/scripts/backfill-post-embeddings.ts",
    "backfill-member-preference-embeddings": "tsx src/scripts/backfill-member-preference-embeddings.ts"
  },
  "dependencies": {
    "@blog-study/shared": "workspace:*",
    "@sentry/node": "^10.43.0",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^6.0.2",
    "axios": "^1.13.5",
    "cheerio": "^1.2.0",
    "discord.js": "^14.25.1",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.33.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "feedsmith": "^2.9.0",
    "pg-boss": "^12.13.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fast-check": "^3.19.0",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^1.6.0"
  }
