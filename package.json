{
  "name": "blog-study-discord-bot",
  "version": "1.0.0",
  "private": true,
  "description": "블로그 글쓰기 스터디 디스코드 봇 시스템",
  "scripts": {
    "dev:bot": "pnpm --filter @blog-study/bot dev",
    "dev:web": "pnpm --filter @blog-study/web dev",
    "build": "pnpm -r build",
    "build:bot": "pnpm --filter @blog-study/bot build",
    "build:web": "pnpm --filter @blog-study/web build",
    "lint": "pnpm -r lint",
    "format": "prettier --write \"packages/**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"packages/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck"
  },
  "keywords": [
    "discord",
    "bot",
    "blog",
    "study",
    "rss"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "@types/react": "19.2.14",
      "@types/react-dom": "19.2.3"
    }
  }
}
